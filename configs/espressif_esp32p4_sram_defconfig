CONFIG_RISCV=y
CONFIG_SYS_ICACHE_OFF=y
CONFIG_SYS_DCACHE_OFF=y
CONFIG_TEXT_BASE=0x4ff00000
CONFIG_SYS_MALLOC_LEN=0x10000
CONFIG_SYS_MALLOC_F_LEN=0x2000
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x4ff3bfc0
CONFIG_DEFAULT_DEVICE_TREE="esp32p4"
CONFIG_SYS_LOAD_ADDR=0x48000000
CONFIG_ARCH_ESPRESSIF=y
CONFIG_TARGET_ESP32P4=y
CONFIG_ESP32P4_SPL_WDT_HANDOFF=y
CONFIG_ESP32P4_SRAM_ONLY=y
CONFIG_CMODEL_MEDANY=y
# CONFIG_RISCV_ISA_F is not set
# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="bootflow scan"
CONFIG_BOARD_LATE_INIT=y
CONFIG_SYS_PROMPT="esp32p4> "
# CONFIG_CMD_BOOTI is not set
# CONFIG_CMD_FDT is not set
# CONFIG_NET is not set
CONFIG_ESP_SERIAL=y
CONFIG_TIMER_EARLY=y
CONFIG_SHA256=y
CONFIG_SHA256_SMALL=y
