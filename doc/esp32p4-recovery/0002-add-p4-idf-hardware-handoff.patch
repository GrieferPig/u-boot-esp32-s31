From: ESP32-S31 Linux contributors
Subject: [PATCH] riscv: add explicit P4 IDF hardware handoff variant

Preserve the emulator target. Require real firmware cache maintenance for
relocation and Linux entry, and keep U-Boot stack away from retained IDF SRAM.

Upstream: Not applicable [experimental downstream platform]
---
diff --git a/board/espressif/esp32p4/Kconfig b/board/espressif/esp32p4/Kconfig
--- a/board/espressif/esp32p4/Kconfig
+++ b/board/espressif/esp32p4/Kconfig
@@ -11,4 +11,10 @@
 config BOARD_SPECIFIC_OPTIONS
 	def_bool y
 	select GENERIC_RISCV
+config ESP32P4_HW_IDF_HANDOFF
+	bool "Use the ESP-IDF hardware handoff contract"
+	default n
+	help
+	  Require a firmware-provided IRAM cache synchronization callback and
+	  revision metadata. The normal emulator board remains unchanged.
 endif
diff --git a/board/espressif/esp32p4/Makefile b/board/espressif/esp32p4/Makefile
--- a/board/espressif/esp32p4/Makefile
+++ b/board/espressif/esp32p4/Makefile
@@ -1,2 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0+
 obj-y += board.o timer.o
+obj-$(CONFIG_ESP32P4_HW_IDF_HANDOFF) += hw_handoff.o
diff --git a/board/espressif/esp32p4/board.c b/board/espressif/esp32p4/board.c
--- a/board/espressif/esp32p4/board.c
+++ b/board/espressif/esp32p4/board.c
@@ -17,7 +17,11 @@
 
 int board_late_init(void)
 {
+#ifdef CONFIG_ESP32P4_HW_IDF_HANDOFF
+	puts("P4_UBOOT: IDF hardware handoff (experimental)\n");
+#else
 	puts("P4_UBOOT: M-mode bootloader active (emulator only)\n");
+#endif
 	return 0;
 }
 
diff --git a/arch/riscv/lib/cache.c b/arch/riscv/lib/cache.c
--- a/arch/riscv/lib/cache.c
+++ b/arch/riscv/lib/cache.c
@@ -6,8 +6,15 @@
 
 #include <cpu_func.h>
 
+#ifdef CONFIG_ESP32P4_HW_IDF_HANDOFF
+void esp32p4_hardware_cache_sync(void);
+#endif
+
 void invalidate_icache_all(void)
 {
+#ifdef CONFIG_ESP32P4_HW_IDF_HANDOFF
+	esp32p4_hardware_cache_sync();
+#endif
 	asm volatile ("fence.i" ::: "memory");
 }
 
diff --git a/arch/riscv/cpu/start.S b/arch/riscv/cpu/start.S
--- a/arch/riscv/cpu/start.S
+++ b/arch/riscv/cpu/start.S
@@ -405,8 +405,15 @@
  * initialization, now running from RAM.
  */
 call_board_init_r:
+#ifdef CONFIG_ESP32P4_HW_IDF_HANDOFF
+	/* A real C cache callback may clobber caller-saved t6. */
+	mv	s6, t6
+#endif
 	jal	invalidate_icache_all
 	jal	flush_dcache_all
+#ifdef CONFIG_ESP32P4_HW_IDF_HANDOFF
+	mv	t6, s6
+#endif
 	la	t0, board_init_r        /* offset of board_init_r() */
 	add	t4, t0, t6		/* real address of board_init_r() */
 /*
diff --git a/board/espressif/esp32p4/hw_handoff.c b/board/espressif/esp32p4/hw_handoff.c
new file mode 100644
--- /dev/null
+++ b/board/espressif/esp32p4/hw_handoff.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Hardware-only contract supplied by the IDF loader, not a guessed ROM ABI. */
+#include <cpu_func.h>
+#include <hang.h>
+#include <stdio.h>
+#include <linux/libfdt.h>
+#include <asm/global_data.h>
+DECLARE_GLOBAL_DATA_PTR;
+
+void esp32p4_hardware_cache_sync(void)
+{
+	const void *fdt = (const void *)(uintptr_t)gd->arch.firmware_fdt_addr;
+	const fdt32_t *entry, *revision;
+	int chosen, len;
+	unsigned long address;
+	int (*sync)(unsigned int start, unsigned int bytes);
+
+	if (!fdt || fdt_check_header(fdt))
+		goto bad;
+	chosen = fdt_path_offset(fdt, "/chosen");
+	if (chosen < 0)
+		goto bad;
+	revision = fdt_getprop(fdt, chosen, "espressif,chip-revision", &len);
+	if (!revision || len != 4 || fdt32_to_cpu(*revision) != 103)
+		goto bad;
+	entry = fdt_getprop(fdt, chosen, "espressif,cache-sync-entry", &len);
+	if (!entry || len != 4)
+		goto bad;
+	address = fdt32_to_cpu(*entry);
+	if (address < 0x4ff00000 || address >= 0x4ffc0000 || (address & 1))
+		goto bad;
+	sync = (void *)address;
+	if (sync(0x48000000, 0x01000000))
+		goto bad;
+	return;
+bad:
+	puts("P4_UBOOT: invalid hardware cache handoff\n");
+	hang();
+}
+
+void flush_dcache_all(void)
+{
+	esp32p4_hardware_cache_sync();
+}
+
+void flush_dcache_range(unsigned long start, unsigned long end)
+{
+	/* U-Boot owns only this PSRAM window; use the serialized full sync. */
+	if (end > start && start < 0x49000000 && end > 0x48000000)
+		esp32p4_hardware_cache_sync();
+}
diff --git a/configs/espressif_esp32p4_hw_defconfig b/configs/espressif_esp32p4_hw_defconfig
new file mode 100644
--- /dev/null
+++ b/configs/espressif_esp32p4_hw_defconfig
@@ -0,0 +1,34 @@
+CONFIG_RISCV=y
+CONFIG_TARGET_ESP32P4=y
+CONFIG_RISCV_MMODE=y
+CONFIG_CMODEL_MEDANY=y
+# CONFIG_RISCV_ISA_F is not set
+# CONFIG_RISCV_ACLINT is not set
+CONFIG_SYS_ICACHE_OFF=y
+CONFIG_SYS_DCACHE_OFF=y
+CONFIG_TEXT_BASE=0x48c00000
+CONFIG_SYS_MALLOC_LEN=0x40000
+CONFIG_SYS_MALLOC_F_LEN=0x4000
+CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
+CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x48bf0000
+CONFIG_DEFAULT_DEVICE_TREE="esp32p4-hw"
+CONFIG_SYS_LOAD_ADDR=0x48000000
+CONFIG_OF_SEPARATE=y
+CONFIG_TIMER=y
+# CONFIG_BOOTSTD is not set
+CONFIG_BOOTDELAY=2
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="booti 0x48000000 - 0x48f00000"
+CONFIG_BOARD_LATE_INIT=y
+CONFIG_SYS_PROMPT="esp32p4> "
+CONFIG_CMD_BOOTI=y
+CONFIG_CMD_FDT=y
+CONFIG_CMD_MEMTEST=y
+# CONFIG_CMD_NET is not set
+# CONFIG_NET is not set
+# CONFIG_EFI_LOADER is not set
+# CONFIG_GZIP is not set
+CONFIG_ESP_SERIAL=y
+CONFIG_CC_OPTIMIZE_FOR_SIZE=y
+# CONFIG_CC_OPTIMIZE_FOR_SPEED is not set
+CONFIG_ESP32P4_HW_IDF_HANDOFF=y
diff --git a/arch/riscv/dts/Makefile b/arch/riscv/dts/Makefile
--- a/arch/riscv/dts/Makefile
+++ b/arch/riscv/dts/Makefile
@@ -26,3 +26,4 @@
 clean-files := *.dtb
 
 dtb-$(CONFIG_TARGET_ESP32P4) += esp32p4.dtb
+dtb-$(CONFIG_ESP32P4_HW_IDF_HANDOFF) += esp32p4-hw.dtb
diff --git a/arch/riscv/dts/esp32p4-hw.dts b/arch/riscv/dts/esp32p4-hw.dts
new file mode 100644
--- /dev/null
+++ b/arch/riscv/dts/esp32p4-hw.dts
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include "esp32p4.dts"
+
+/ {
+	model = "Espressif ESP32-P4 v1.3 IDF hardware handoff";
+	cpus {
+		cpu@0 {
+			clock-frequency = <360000000>;
+		};
+	};
+};
