if TARGET_ESP32P4

config SYS_BOARD
	default "esp32p4"

config SYS_VENDOR
	default "espressif"

config SYS_CPU
	default "generic"

config SYS_CONFIG_NAME
	default "esp32p4"

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select GENERIC_RISCV
	select SUPPORT_SPL

config ESP32P4_SPL_PSRAM_200MHZ
	bool "Run rev1.3 AP Hex PSRAM at 200 MHz"
	depends on SPL
	help
	  Select the validated 200 MHz timing profile. The default
	  is the board's 80 MHz configuration.

config ESP32P4_SPL_FIT_PAYLOAD
	def_bool y
	depends on SPL
	select SPL_SHA256
	select SPL_OF_LIBFDT
	help
	  ROM enters U-Boot SPL directly. The FIT selects M-mode U-Boot,
	  RV32 Linux and its DTB; no ESP-IDF app loader or OpenSBI stage.

config ESP32P4_NOR_BOOTMETH
	def_bool y
	depends on ESP32P4_SRAM_ONLY && BOOTSTD && !SPL
	select BOOTMETH_GLOBAL

config ESP32P4_SPL_WDT_HANDOFF
	bool "Preserve watchdog ownership passed from the native SPL"
	depends on ESP32P4_SRAM_ONLY
	help
	  The paired SPL protects boot with the RTC watchdog until application
	  handoff. Do not subsequently disable the always-on super watchdog
	  or reset the timer-group watchdog registers from U-Boot proper.

config ESP32P4_SRAM_ONLY
	bool "Run U-Boot proper from internal SRAM"
	select BOARD_PRELOADED_RUNTIME
	help
	  Load U-Boot proper into the lower half of the HP SRAM (0x4ff00000) so
	  it does not depend on the PSRAM window the ROM leaves mapped.

endif
