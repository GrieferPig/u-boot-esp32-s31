if TARGET_ESP32P4

config SYS_BOARD
	default "esp32p4"

config SYS_VENDOR
	default "espressif"

config SYS_CPU
	default "generic"

config SYS_CONFIG_NAME
	default "esp32p4"

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select GENERIC_RISCV
	select SUPPORT_SPL

config ESP32P4_HW_IDF_HANDOFF
	bool "Use the ESP-IDF hardware handoff contract"
	default n
	help
	  Require a firmware-provided IRAM cache synchronization callback and
	  revision metadata. The normal emulator board remains unchanged.

endif

config ESP32P4_LOW_RAM_TOP
	bool "Run U-Boot from the ROM-mapped 896 KiB PSRAM window"
	help
	  The ROM only leaves part of the PSRAM window mapped. Select this to
	  place U-Boot proper at 0x48000000 and cap usable RAM at 0x480e0000 so
	  it can run from that window when booted by the SPL.
