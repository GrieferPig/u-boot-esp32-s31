if ARCH_ESPRESSIF

choice
	prompt "Espressif target"
	default TARGET_ESP32S31

config TARGET_ESP32S31
    bool "ESP32-S31"

config TARGET_ESP32P4
	bool "ESP32-P4"
	help
	  Build the native RV32 M-mode bootloader for the Espressif ESP32-P4.
	  The revision 1.3 port loads SPL from SPI NOR and runs U-Boot proper
	  in internal SRAM.

endchoice

if TARGET_ESP32S31
source "board/espressif/esp32s31/Kconfig"
endif

if TARGET_ESP32P4
source "board/espressif/esp32p4/Kconfig"
endif

endif
