if TARGET_ESP32S31

config SYS_BOARD
	default "esp32s31"

config SYS_VENDOR
	default "espressif"

config SYS_CPU
	default "generic"

config SYS_CONFIG_NAME
	default "esp32s31"

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select GENERIC_RISCV
	select SUPPORT_SPL

config ESP32S31_PSRAM_COMPAT_200MHZ
	bool "ESP32-S31 initial 200 MHz PSRAM compatibility profile"
	default n
	help
	  Select an experimental initial 400 MHz MPLL / 200 MHz MSPI
	  profile for boards on which the 500 MHz MPLL calibration stalls.
	  Enable the analog I2C gates early and use the ESP-IDF 200 MHz
	  latency settings. Bypass the 250 MHz training sequence. The
	  later EMAC MPLL setup is unchanged; steady-state PSRAM timing
	  and Ethernet operation require separate validation.

config ESP32S31_NOR_BOOTMETH
	def_bool y
	depends on BOOTSTD && CMD_BOOTI
	select BOOTMETH_GLOBAL

endif
