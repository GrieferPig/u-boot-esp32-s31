config GENERIC_RISCV
	bool
	select BINMAN if SPL
	select ARCH_EARLY_INIT_R
	select SYS_CACHE_SHIFT_6
	imply CPU
	imply CPU_RISCV
	imply RISCV_TIMER if (RISCV_SMODE || SPL_RISCV_SMODE)
	# The ESP32-P4 has no ACLINT block; its timebase is the SYSTIMER.
	imply RISCV_ACLINT if RISCV_MMODE && !TARGET_ESP32P4
	imply SPL_RISCV_ACLINT if SPL_RISCV_MMODE && !TARGET_ESP32P4
	imply CMD_CPU
	imply SPL_CPU
	imply SPL_OPENSBI
	imply SPL_LOAD_FIT
